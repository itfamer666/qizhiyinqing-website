# 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# 钉钉 AI 表格 Webhook（必填）
# 在钉钉 AI 表格中创建自动化流程，获取 Webhook 地址
DINGTALK_WEBHOOK=https://connector.dingtalk.com/webhook/flow/your-webhook-id

# SMTP 配置（可选，当前使用钉钉推送）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your-email@qq.com
# SMTP_PASS=your-authorization-code
# RECIPIENT_EMAIL=recipient@example.com
